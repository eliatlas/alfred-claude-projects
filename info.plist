				<key>script</key>
				<string>DIR="$1"
ACTION="${action:-claude}"

if [ "$ACTION" = "finder" ]; then
	open -R "$DIR"
	exit 0
fi

if [ "$ACTION" = "copy" ]; then
	printf '%s' "$DIR" | pbcopy
	exit 0
fi

if [ "$ACTION" = "codex" ]; then
	if command -v codex &gt;/dev/null 2&gt;&amp;1; then
		codex app "$DIR"
	elif [ -x /opt/homebrew/bin/codex ]; then
		/opt/homebrew/bin/codex app "$DIR"
	elif [ -x /usr/local/bin/codex ]; then
		/usr/local/bin/codex app "$DIR"
	else
		osascript -e 'display notification "Install the Codex CLI first" with title "Codex Projects"'
		exit 127
	fi
	exit 0
fi

osascript &lt;&lt;APPLESCRIPT
tell application "iTerm"
	activate
	create window with default profile
	tell current session of current window
		write text "cd \"$DIR\" &amp;&amp; clear &amp;&amp; claude"
	end tell
end tell
APPLESCRIPT</string>
